<p>{{ section.settings.text }}</p>
<p>{{ section.settings.link }}</p>
<p>{{ section.settings.color_bg }}</p>
<p>{{ section.settings.color_text }}</p>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Welcome to our store"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
