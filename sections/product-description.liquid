<div class="max-w-[1280px] mx-auto px-4 md:px-0 py-8">
  <div
    class="w-full flex flex-col gap-[16px] rounded-[8px] border-[0.8px] border-primary bg-transparent p-[18px]"
  >
    <!-- Title -->
    <h2
      class="font-body font-bold text-[20px] leading-[100%] text-text text-left"
    >
      Description
    </h2>

    <!-- Divider -->
    <div
      class="w-full h-px border-t-[0.8px] border-text"
    ></div>

    <!-- Content -->
    <div
      class="font-body font-normal text-[16px] leading-[21px] text-text rte"
    >
      {{ product.description }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Description",
  "tag": "section",
  "class": "section-product-description",
  "settings": [],
  "presets": [
    {
      "name": "Product Description"
    }
  ]
}
{% endschema %}
