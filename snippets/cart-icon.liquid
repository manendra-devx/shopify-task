<button
  type="button"
  class="relative bg-transparent border-none cursor-pointer p-2"
  aria-label="Open cart"
  data-cart-open-trigger
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M6 7H21L18 15H6V7ZM6 7V4L3 3" stroke="#025A60" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="8.5" cy="19.5" r="1.5" stroke="#025A60" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="16.5" cy="19.5" r="1.5" stroke="#025A60" stroke-width="1.5" stroke-linecap="round"/>
  </svg>

  <span
    class="cart-item-count absolute top-0 right-0 w-5 h-5 bg-black text-white text-xs rounded-full flex items-center justify-center"
  >
    {{ cart.item_count }}
  </span>
</button>
